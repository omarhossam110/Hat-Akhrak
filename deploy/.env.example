# Copy to .env (never commit it). Generate each secret with:  openssl rand -base64 48

# Public address of the site, no trailing slash. Used for CORS and the links in emails.
PUBLIC_URL=http://localhost

# --- Database -----------------------------------------------------------------
# Option A: Postgres inside this stack (run with: docker compose --profile local-db up -d)
#   DB_PASSWORD=change-me
#   DATABASE_URL=postgresql://hat:change-me@db:5432/hat_akhrak
# Option B: hosted Postgres (Supabase etc.) — use its connection string, with ?sslmode=require if it asks for it
DATABASE_URL=

# --- Secrets (all required; keep them stable) -----------------------------------
JWT_SECRET=
# Encrypt 2FA secrets / merchant tax ids at rest. Losing or changing these makes that data unreadable.
TOTP_ENCRYPTION_KEY=
TAX_ID_ENCRYPTION_KEY=

# true = every super-admin endpoint requires a 2nd factor. Enrol the admin's 2FA first
# (log in, /super-admin/security), otherwise you lock yourself out of the admin pages.
REQUIRE_ADMIN_2FA=true

# --- Email (any SMTP provider; empty SMTP_HOST = emails are only logged) ---------
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Hat Akhrak <no-reply@example.com>"

# --- Optional ---------------------------------------------------------------------
# Baked into the browser bundle at build time (rebuild after changing).
NEXT_PUBLIC_META_PIXEL_ID=
# Where the backend repo is checked out, relative to this folder.
# BACKEND_CONTEXT=../../hat-akhrak-backend
