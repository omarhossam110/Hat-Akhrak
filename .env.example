# Supabase project settings (Project Settings → API in the Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only — never expose to the browser. Used for admin/super-admin
# operations that must bypass Row Level Security (payouts, emergency cancel,
# dispute resolution).
SUPABASE_SERVICE_ROLE_KEY=

# Payment gateway (provider TBD — Paymob-like placeholder)
PAYMENT_GATEWAY_API_KEY=
PAYMENT_GATEWAY_SECRET=

# Meta Pixel (ad tracking)
NEXT_PUBLIC_META_PIXEL_ID=
