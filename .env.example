# Payment gateway (provider TBD — Paymob-like placeholder)
PAYMENT_GATEWAY_API_KEY=
PAYMENT_GATEWAY_SECRET=

# Meta Pixel (ad tracking)
NEXT_PUBLIC_META_PIXEL_ID=

# The hat-akhrak-backend API (NestJS) this app's server actions call for
# auth (signup/login/merchant-signup/forgot-reset-password). Server-only —
# never exposed to the browser; the frontend only ever holds an httpOnly
# session cookie with the backend's JWT inside it, never a client-side
# reference to this URL.
BACKEND_URL="http://localhost:3001/api"
